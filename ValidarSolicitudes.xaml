<Activity mc:Ignorable="sap sap2010" x:Class="ValidarSolicitudes" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib" xmlns:sd="clr-namespace:System.Data;assembly=System.Data.Common" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_Solicitudes" Type="InArgument(sd:DataTable)" />
    <x:Property Name="in_Catalogo" Type="InArgument(sd:DataTable)" />
    <x:Property Name="out_Resultados" Type="OutArgument(sd:DataTable)" />
    <x:Property Name="out_TotalProcesables" Type="OutArgument(x:Int32)" />
    <x:Property Name="out_TotalCorreccion" Type="OutArgument(x:Int32)" />
  </x:Members>
  <VisualBasic.Settings>
    <x:Null />
  </VisualBasic.Settings>
  <sap2010:WorkflowViewState.IdRef>ActivityBuilder_1</sap2010:WorkflowViewState.IdRef>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System.Activities</x:String>
      <x:String>System.Activities.Statements</x:String>
      <x:String>System.Activities.Expressions</x:String>
      <x:String>System.Activities.Validation</x:String>
      <x:String>System.Activities.XamlIntegration</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
      <x:String>Microsoft.VisualBasic.Activities</x:String>
      <x:String>System</x:String>
      <x:String>System.Collections</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Collections.ObjectModel</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.Diagnostics</x:String>
      <x:String>System.Drawing</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>System.Net.Mail</x:String>
      <x:String>System.Text.RegularExpressions</x:String>
      <x:String>System.Xml</x:String>
      <x:String>System.Xml.Linq</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>System.Windows.Markup</x:String>
      <x:String>GlobalVariablesNamespace</x:String>
      <x:String>GlobalConstantsNamespace</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.Data.Common</AssemblyReference>
      <AssemblyReference>System.Drawing</AssemblyReference>
      <AssemblyReference>System.Drawing.Primitives</AssemblyReference>
      <AssemblyReference>System.Drawing.Common</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Xml</AssemblyReference>
      <AssemblyReference>System.Xml.Linq</AssemblyReference>
      <AssemblyReference>PresentationFramework</AssemblyReference>
      <AssemblyReference>WindowsBase</AssemblyReference>
      <AssemblyReference>PresentationCore</AssemblyReference>
      <AssemblyReference>System.Xaml</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.UiAutomation.Activities</AssemblyReference>
      <AssemblyReference>System.Data.DataSetExtensions</AssemblyReference>
      <AssemblyReference>System.Net.Mail</AssemblyReference>
      <AssemblyReference>System.ObjectModel</AssemblyReference>
      <AssemblyReference>System.ComponentModel.TypeConverter</AssemblyReference>
      <AssemblyReference>System.Text.RegularExpressions</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Validar Solicitudes" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="scg:List(x:String)" Name="lstCarreras" />
      <Variable x:TypeArguments="scg:List(x:String)" Name="lstRepetidas" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <Assign DisplayName="Copiar solicitudes a resultados" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="sd:DataTable">[out_Resultados]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="sd:DataTable">[in_Solicitudes.Copy()]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Cargar catálogo de carreras" sap2010:WorkflowViewState.IdRef="Assign_2">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:List(x:String)">[lstCarreras]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:List(x:String)">[in_Catalogo.AsEnumerable().Select(Function(r) r("Carrera").ToString().Trim().ToUpper()).Where(Function(c) c &lt;&gt; "").ToList()]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Detectar cédulas repetidas" sap2010:WorkflowViewState.IdRef="Assign_3">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:List(x:String)">[lstRepetidas]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:List(x:String)">[out_Resultados.AsEnumerable().Select(Function(r) r("Cédula").ToString().Trim()).Where(Function(c) c &lt;&gt; "").GroupBy(Function(c) c).Where(Function(g) g.Count() &gt; 1).Select(Function(g) g.Key).ToList()]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:AddDataColumn x:TypeArguments="x:String" DisplayName="Agregar columna Estado" sap2010:WorkflowViewState.IdRef="AddDataColumn`1_1">
      <ui:AddDataColumn.DataTable>
        <InArgument x:TypeArguments="sd:DataTable">[out_Resultados]</InArgument>
      </ui:AddDataColumn.DataTable>
      <ui:AddDataColumn.ColumnName>
        <InArgument x:TypeArguments="x:String">["Estado"]</InArgument>
      </ui:AddDataColumn.ColumnName>
    </ui:AddDataColumn>
    <ui:AddDataColumn x:TypeArguments="x:String" DisplayName="Agregar columna Motivo" sap2010:WorkflowViewState.IdRef="AddDataColumn`1_2">
      <ui:AddDataColumn.DataTable>
        <InArgument x:TypeArguments="sd:DataTable">[out_Resultados]</InArgument>
      </ui:AddDataColumn.DataTable>
      <ui:AddDataColumn.ColumnName>
        <InArgument x:TypeArguments="x:String">["Motivo"]</InArgument>
      </ui:AddDataColumn.ColumnName>
      <ui:AddDataColumn.MaxLength>
        <InArgument x:TypeArguments="x:Int32">500</InArgument>
      </ui:AddDataColumn.MaxLength>
    </ui:AddDataColumn>
    <ui:ForEachRow DataTable="[out_Resultados]" DisplayName="Validar cada solicitud" sap2010:WorkflowViewState.IdRef="ForEachRow_1">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="CurrentRow" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <Sequence.Variables>
              <Variable x:TypeArguments="x:String" Name="nombre" />
              <Variable x:TypeArguments="x:String" Name="cedula" />
              <Variable x:TypeArguments="x:String" Name="correo" />
              <Variable x:TypeArguments="x:String" Name="carrera" />
              <Variable x:TypeArguments="scg:List(x:String)" Name="motivos" />
            </Sequence.Variables>
            <sap:WorkflowViewStateService.ViewState>
              <scg:Dictionary x:TypeArguments="x:String, x:Object">
                <x:Boolean x:Key="IsExpanded">True</x:Boolean>
              </scg:Dictionary>
            </sap:WorkflowViewStateService.ViewState>
            <Assign DisplayName="Leer Nombre" sap2010:WorkflowViewState.IdRef="Assign_4">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[nombre]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">[CurrentRow("Nombre").ToString().Trim()]</InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Leer Cédula (como texto)" sap2010:WorkflowViewState.IdRef="Assign_5">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[cedula]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">[CurrentRow("Cédula").ToString().Trim()]</InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Leer Correo" sap2010:WorkflowViewState.IdRef="Assign_6">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[correo]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">[CurrentRow("Correo").ToString().Trim()]</InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Leer Carrera" sap2010:WorkflowViewState.IdRef="Assign_7">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">[carrera]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">[CurrentRow("Carrera").ToString().Trim()]</InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Iniciar lista de motivos" sap2010:WorkflowViewState.IdRef="Assign_8">
              <Assign.To>
                <OutArgument x:TypeArguments="scg:List(x:String)">[motivos]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="scg:List(x:String)">[New List(Of String)]</InArgument>
              </Assign.Value>
            </Assign>
            <If Condition="[String.IsNullOrWhiteSpace(nombre)]" DisplayName="Regla: Nombre no vacío" sap2010:WorkflowViewState.IdRef="If_1">
              <If.Then>
                <AddToCollection x:TypeArguments="x:String" Collection="[motivos]" DisplayName="Motivo: nombre vacío" Item="[&quot;Nombre vacío&quot;]" sap2010:WorkflowViewState.IdRef="AddToCollection`1_1" />
              </If.Then>
            </If>
            <If Condition="[String.IsNullOrWhiteSpace(correo)]" DisplayName="Regla: Correo no vacío" sap2010:WorkflowViewState.IdRef="If_2">
              <If.Then>
                <AddToCollection x:TypeArguments="x:String" Collection="[motivos]" DisplayName="Motivo: correo vacío" Item="[&quot;Correo vacío&quot;]" sap2010:WorkflowViewState.IdRef="AddToCollection`1_2" />
              </If.Then>
            </If>
            <If Condition="[String.IsNullOrWhiteSpace(cedula)]" DisplayName="Regla: Cédula no vacía" sap2010:WorkflowViewState.IdRef="If_3">
              <If.Then>
                <AddToCollection x:TypeArguments="x:String" Collection="[motivos]" DisplayName="Motivo: cédula vacía" Item="[&quot;Cédula vacía&quot;]" sap2010:WorkflowViewState.IdRef="AddToCollection`1_3" />
              </If.Then>
              <If.Else>
                <If Condition="[Not Regex.IsMatch(cedula, &quot;^\d{10}$&quot;)]" DisplayName="Regla: Cédula con 10 dígitos" sap2010:WorkflowViewState.IdRef="If_4">
                  <If.Then>
                    <AddToCollection x:TypeArguments="x:String" Collection="[motivos]" DisplayName="Motivo: cédula inválida" Item="[&quot;Cédula debe tener exactamente 10 dígitos&quot;]" sap2010:WorkflowViewState.IdRef="AddToCollection`1_4" />
                  </If.Then>
                </If>
              </If.Else>
            </If>
            <If Condition="[lstRepetidas.Contains(cedula)]" DisplayName="Regla: Cédula no repetida" sap2010:WorkflowViewState.IdRef="If_5">
              <If.Then>
                <AddToCollection x:TypeArguments="x:String" Collection="[motivos]" DisplayName="Motivo: cédula repetida" Item="[&quot;Cédula repetida&quot;]" sap2010:WorkflowViewState.IdRef="AddToCollection`1_5" />
              </If.Then>
            </If>
            <If Condition="[Not lstCarreras.Contains(carrera.ToUpper())]" DisplayName="Regla: Carrera en catálogo" sap2010:WorkflowViewState.IdRef="If_6">
              <If.Then>
                <AddToCollection x:TypeArguments="x:String" Collection="[motivos]" DisplayName="Motivo: carrera fuera del catálogo" Item="[If(carrera = &quot;&quot;, &quot;Carrera vacía&quot;, &quot;Carrera fuera del catálogo&quot;)]" sap2010:WorkflowViewState.IdRef="AddToCollection`1_6" />
              </If.Then>
            </If>
            <Assign DisplayName="Asignar Estado" sap2010:WorkflowViewState.IdRef="Assign_9">
              <Assign.To>
                <OutArgument x:TypeArguments="x:Object">[CurrentRow("Estado")]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:Object">[If(motivos.Count = 0, "Procesable", "Requiere corrección")]</InArgument>
              </Assign.Value>
            </Assign>
            <Assign DisplayName="Asignar Motivo" sap2010:WorkflowViewState.IdRef="Assign_10">
              <Assign.To>
                <OutArgument x:TypeArguments="x:Object">[CurrentRow("Motivo")]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:Object">[If(motivos.Count = 0, "Sin observaciones", String.Join("; ", motivos))]</InArgument>
              </Assign.Value>
            </Assign>
          </Sequence>
        </ActivityAction>
      </ui:ForEachRow.Body>
    </ui:ForEachRow>
    <Assign DisplayName="Contar procesables" sap2010:WorkflowViewState.IdRef="Assign_11">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Int32">[out_TotalProcesables]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32">[out_Resultados.AsEnumerable().Count(Function(r) r("Estado").ToString() = "Procesable")]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Contar con corrección" sap2010:WorkflowViewState.IdRef="Assign_12">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Int32">[out_TotalCorreccion]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32">[out_Resultados.Rows.Count - out_TotalProcesables]</InArgument>
      </Assign.Value>
    </Assign>
  </Sequence>
</Activity>
